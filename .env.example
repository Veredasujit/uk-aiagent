# Vedronix US agent — copy to .env.production on the server. Never commit real values.
PUBLIC_HOST=uk-agent.vedronix.com
APP_SECRET=                      # openssl rand -hex 32
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
DEEPGRAM_API_KEY=                # speech recognition (en-US) and the Aura-2 voice
DEEPGRAM_TTS_VOICE=aura-2-thalia-en
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=               # only to validate X-Twilio-Signature
TWILIO_API_KEY_SID=              # SK…, created by deploy/twilio_setup.py
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=            # AP…, created by deploy/twilio_setup.py
TWILIO_PHONE_NUMBER=+447427893469
WEB_ALLOWED_ORIGINS=https://vedronix.com,https://www.vedronix.com

# WhatsApp to callers (booking confirmed, thanks, missed call, reminder) via the Vedronix gateway
WHATSAPP_API_KEY=
WHATSAPP_API_URL=https://whatsappev.vedronix.com/api/v1/messages/text
WHATSAPP_THANKS=true
WHATSAPP_MISSED=true
WHATSAPP_REMINDERS=true

# Outbound call API (/v1/calls). Keys are sha256 hashes: python -m app.outbound new <name>
OUTBOUND_API_KEYS=
# Signs result webhooks (X-Vedronix-Signature): python -m app.outbound secret
OUTBOUND_WEBHOOK_SECRET=
OUTBOUND_MAX_CONCURRENT=3
OUTBOUND_INBOUND_RESERVE=2
